{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filmov",
  "version": "0.1.0",
  "identifier": "com.filmov.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Filmov - Video Editor & Downloader",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/**",
          "$DOWNLOAD/**",
          "$AUDIO/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$TEMP/**",
          "$RESOURCE/**"
        ]
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data: blob: asset: http://asset.localhost https://asset.localhost; media-src 'self' https: data: blob: asset: http://asset.localhost https://asset.localhost asset://*; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https: ipc: http://ipc.localhost https://asset.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "resources": [
      "binaries/*"
    ]
  }
}